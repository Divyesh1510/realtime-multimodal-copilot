# Environment Configuration for $0 Copilot
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model Selection (Default: Free Gemini 2.0 Flash / Qwen 2.5 VL)
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_TEXT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Debounce & VAD Settings
SPEAKER_SILENCE_DEBOUNCE_SEC=1.5
CONFIDENCE_THRESHOLD=0.6
DATABASE_URL=sqlite+aiosqlite:///./copilot_sessions.db
